/* ---------------------------------------------------------------
   BACKEND #1 — DEMO (in-memory)
--------------------------------------------------------------- */
function makeDemoDB(){
  let seq = 1800;
  const store = [], log = [], files = [], data = {};
  const caseL = new Set(), fileL = new Set(), logL = new Set();
  let authCb = null;
  const clone = o => JSON.parse(JSON.stringify(o));
  const pickCases = o => clone(o.all ? store : store.filter(c => c.ownerUid === o.ownerUid));
  const pickFiles = o => clone(o.all ? files : files.filter(f => f.ownerUid === o.ownerUid));
  const emit = () => {
    caseL.forEach(l => l.cb(pickCases(l.opts)));
    fileL.forEach(l => l.cb(pickFiles(l.opts)));
    logL.forEach(cb => cb(clone(log)));
  };
  const find = no => store.find(c => c.caseNo === no);
  const appendTo = (c, appends) => Object.entries(appends || {}).forEach(([k, items]) => {
    c[k] = c[k] || []; (items || []).forEach(i => c[k].push(i));
  });
  return {
    mode: 'demo',
    onAuth(cb){ authCb = cb; cb(null); },
    demoLogin(profile){ authCb && authCb(profile); },
    async signOut(){ authCb && authCb(null); },
    subscribeCases(opts, cb){
      const l = { opts, cb }; caseL.add(l);
      setTimeout(() => cb(pickCases(opts)), 0);
      return () => caseL.delete(l);
    },
    subscribeFiles(opts, cb){
      const l = { opts, cb }; fileL.add(l);
      setTimeout(() => cb(pickFiles(opts)), 0);
      return () => fileL.delete(l);
    },
    subscribeCallLog(cb){
      logL.add(cb);
      setTimeout(() => cb(clone(log)), 0);
      return () => logL.delete(cb);
    },
    async createCase(record){
      seq += 1;
      record.caseNo = `ESL-${new Date().getFullYear()}-${String(seq).padStart(5, '0')}`;
      store.unshift(clone(record));
      emit();
      return record.caseNo;
    },
    async updateCase(caseNo, patch, appends){
      const c = find(caseNo); if(!c) throw new Error('Case not found');
      if(Array.isArray(appends)) appends = { timeline: appends };
      Object.assign(c, clone(patch || {}));
      appendTo(c, clone(appends || {}));
      c.updatedAt = Date.now();
      emit();
    },
    async addCallNote(caseNo, note, tl){
      const c = find(caseNo); if(!c) throw new Error('Case not found');
      c.callNotes.push(note); c.timeline.push(tl); c.updatedAt = Date.now();
      log.unshift(note);
      emit();
    },
    async addFile(meta, dataUrl){ data[meta.id] = dataUrl; files.push(clone(meta)); emit(); },
    async getFileData(id){ return data[id] || null; },
    async deleteFile(id){
      const i = files.findIndex(f => f.id === id);
      if(i > -1) files.splice(i, 1);
      delete data[id];
      emit();
    },
  };
}

