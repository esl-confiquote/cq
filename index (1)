function quoteTotals(c){
  const amt = Number(c.quoteAmount) || 0, incl = !!(c.quoteTerms && c.quoteTerms.taxIncl);
  const untaxed = r2(incl ? amt / (1 + TAX.nhil + TAX.getfund + TAX.vat) : amt);
  const nhil = r2(untaxed * TAX.nhil), getfund = r2(untaxed * TAX.getfund);
  let vat = r2(untaxed * TAX.vat), total = r2(untaxed + nhil + getfund + vat);
  if(incl){ total = r2(amt); vat = r2(total - untaxed - nhil - getfund); }
  return { untaxed, nhil, getfund, vat, total };
}
