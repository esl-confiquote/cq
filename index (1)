    `<div class="fb-item"><div class="at">${esc(fmtDT(q.t))} · ${esc(q.by || '')} · revision ${esc(q.rev || '')}</div><b>${esc(fmtMoney(q.amount))}</b>${q.note ? ' — ' + esc(q.note) : ''}</div>`).join('')}</div>`;
  return h;
}
function acceptanceStageHTML(c, idx, mode){
