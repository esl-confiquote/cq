function pickFiles(accept, multiple){
  return new Promise(resolve => {
    const input = document.createElement('input');
    input.type = 'file'; input.accept = accept || ''; input.multiple = !!multiple;
    input.style.display = 'none';
    input.onchange = () => { resolve([...input.files]); input.remove(); };
    input.addEventListener('cancel', () => { resolve([]); input.remove(); });
    document.body.appendChild(input);
    input.click();
  });
}
function compressImage(file){
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      let scale = Math.min(1, 1600 / Math.max(img.width, img.height));
      for(let attempt = 0; attempt < 8; attempt++){
        const cv = document.createElement('canvas');
        cv.width = Math.max(1, Math.round(img.width * scale));
        cv.height = Math.max(1, Math.round(img.height * scale));
        const ctx = cv.getContext('2d');
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, cv.width, cv.height);
        ctx.drawImage(img, 0, 0, cv.width, cv.height);
        for(const q of [0.85, 0.72, 0.6, 0.48]){
          const dataUrl = cv.toDataURL('image/jpeg', q);
          const bytes = Math.round((dataUrl.length - dataUrl.indexOf(',') - 1) * 3 / 4);
          if(bytes <= MAX_FILE_BYTES){
            resolve({ name: file.name.replace(/\.[^.]+$/, '') + '.jpg', dataUrl, size: bytes, mime: 'image/jpeg' });
            return;
          }
        }
        scale *= 0.75;
      }
      reject(new Error(`"${file.name}" is too large to store even after compression. Try a smaller image.`));
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error(`"${file.name}" couldn't be read as an image. Use JPG or PNG.`)); };
    img.src = url;
  });
}
async function prepareUpload(file){
  if(/^image\/(jpeg|png|webp|gif)$/i.test(file.type)) return compressImage(file);
  if(file.size > MAX_FILE_BYTES) throw new Error(`"${file.name}" is ${KB(file.size)} — the limit is ${KB(MAX_FILE_BYTES)} per file. Compress it or split it.`);
  return { name: file.name, dataUrl: await readFileAsDataURL(file), size: file.size, mime: file.type || 'application/octet-stream' };
}
function makeFileMeta(c, kind, p, extra){
