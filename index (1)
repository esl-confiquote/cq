}
async function uploadCaseFile(c, kind, files, opts){
  const o = opts || {};
  let n = 0;
  for(const f of files){
    const p = await prepareUpload(f);
    await DB.addFile(makeFileMeta(c, kind, p, { caption: o.caption || '' }), p.dataUrl);
    n++;
  }
  if(n && o.timeline !== false){
    await DB.updateCase(c.caseNo, {}, { timeline: [entry(o.text || `${KIND_LABEL[kind]} uploaded${n > 1 ? ' (' + n + ' files)' : ''}.`)] });
  }
  return n;
}
function doUpload(c, kind, accept, multiple, opts){
  return run(async () => {
