/* ---- stage panels (what the client sees at each of the six steps) ---- */
function stageChipsHTML(currentStatus, opts){
  const o = opts || {};
  const curIdx = STATUS_STAGES.indexOf(currentStatus);
  return `<div class="stage-strip">` + STATUS_STAGES.map((s, i) => {
    const cls = i < curIdx ? 'done' : (i === curIdx ? 'current' : '');
    const inner = `<div class="conn"></div><div class="dot">${i < curIdx ? '&#10003;' : i + 1}</div><div class="lbl">${esc(s)}</div>`;
    if(!o.clickable) return `<div class="stage ${cls}">${inner}</div>`;
    const sel = o.selected === i;
    return `<button type="button" class="stage ${cls}${sel ? ' selected' : ''}" data-stage="${i}" aria-pressed="${sel}" aria-label="Step ${i + 1}: ${esc(s)}">${inner}</button>`;
  }).join('') + `</div>`;
}
const srowsHTML = rows => rows.map(([k, v]) => `<div class="srow"><div class="sk">${esc(k)}</div><div class="sv">${v}</div></div>`).join('');

function feedbackListHTML(c){
  const list = (c.priceFeedback || []).slice().sort((a, b) => a.t - b.t);
  if(!list.length) return '';
  return `<div><h4>Price feedback &amp; discount requests</h4>` + list.map(f =>
    `<div class="fb-item"><div class="at">${esc(fmtDT(f.t))} · ${esc(f.by || '')}${f.discount ? `<span class="badge-disc">${f.discount}% discount requested</span>` : ''}${f.kind === 'acceptance' ? '<span class="badge-disc">with acceptance</span>' : ''}${f.amount != null ? ' · on ' + esc(fmtMoney(f.amount)) : ''}</div>${f.text ? esc(f.text) : '<i>No comment</i>'}</div>`
  ).join('') + `</div>`;
}
function quoteStageHTML(c, idx, mode){
