function reqWarn(msg){ $('req-warn-slot').innerHTML = `<div class="warn-banner">&#9888; ${esc(msg)}</div>`; window.scrollTo({top:0, behavior:'smooth'}); }

$('btn-submit-request').onclick = async () => {
  const fullName = $('f-fullname').value.trim(), phone = $('f-phone').value.trim(), email = $('f-email').value.trim();
  if(!fullName || !phone || !email){ reqWarn('Please provide at least your full name, phone number and email so an estimator can reach you.'); return; }
  const f = $('f-diagram').files[0];
  let prepared = null;
  if(f){
    try{ prepared = await prepareUpload(f); }
    catch(e){ reqWarn(e.message); return; }
  }
  const panel = PANELS[state.configuratorPanelId];
  const now = Date.now();
  const nda = $('f-nda').checked;
  const orderType = reqFormState.orderType || 'Direct Supply';
  const leadRaw = $('f-lead-value').value.trim();
  let leadTime = null, leadTimeDays = null;
  if(leadRaw){
    const n = Number(leadRaw);
    if(!(n > 0)){ reqWarn('Lead time must be a number greater than zero (or leave it blank).'); return; }
    const unit = $('f-lead-unit').value;
    leadTime = `${n} ${n === 1 ? unit.replace(/s$/, '') : unit}`;
    leadTimeDays = unit === 'weeks' ? n * 7 : n;
  }
  const author = fullName;
  const mk = text => ({ id: uid8(), t: now, text, by: author });
  const timeline = [mk('Case received — configuration and contact details submitted via the self-service portal.')];
  if(state.role === 'sales') timeline.push(mk(`Request entered by ${state.profile.name} (sales) on behalf of the client.`));
  if(orderType.startsWith('Installation')) timeline.push(mk('Flagged for a site survey before the estimator finalises pricing.'));
  if(nda) timeline.push(mk('NDA requested by client — pending ESL digital countersignature.'));
  if(leadTime) timeline.push(mk(`Client requested a lead time of ${leadTime}${leadTimeDays < 14 ? ' (shorter than the standard 2–3 weeks)' : ''}.`));
  const record = {
    panelId: panel.id, panelName: panel.name, panelCode: panel.code,
    ownerUid: state.profile.uid, ownerEmail: state.profile.email || '',
    createdAtMs: now, updatedAt: now,
    values: JSON.parse(JSON.stringify(state.configuratorValues)),
    contact: {
      fullName, company: $('f-company').value.trim(), phone, email,
      location: $('f-location').value.trim(), orderType,
      urgency: reqFormState.urgency || 'Standard (2–3 weeks)',
      leadTime, leadTimeDays,
      diagramFile: f ? f.name : null,
    },
    ndaRequested: nda, ndaStatus: nda ? 'Requested' : 'Not requested',
    status: 'Case Received', assignedEstimatorId: null, quoteAmount: null,
    callNotes: [], timeline,
    eta: null, etaHistory: [], progressNotes: [], priceFeedback: [], quoteHistory: [], quoteNotes: '', quoteRequested: false,
    acceptedAt: null, acceptedAmount: null,
    onBehalfOf: state.role === 'sales', createdBy: state.role === 'sales' ? state.profile.name : '',
  };
  const btn = $('btn-submit-request');
  btn.disabled = true; btn.textContent = 'Submitting…';
  try{
    const caseNo = await DB.createCase(record);
    if(prepared){
      try{ await DB.addFile(makeFileMeta({ caseNo, ownerUid: state.profile.uid }, 'diagram', prepared), prepared.dataUrl); }
      catch(e){ console.error(e); toast('Case submitted, but the diagram could not be attached: ' + friendlyError(e)); }
    }
    state.mycOpenCase = caseNo; state.salesOpenCase = caseNo;
    $('confirm-case-no').textContent = caseNo;
    $('confirm-summary-body').innerHTML = rowsToHTML(specRows(panel, record.values), panel.name) +
      `<div class="srow"><div class="sk">Submitted by</div><div class="sv">${esc(fullName)}</div></div>` +
      `<div class="srow"><div class="sk">Order type</div><div class="sv">${esc(orderType)}</div></div>` +
      (leadTime ? `<div class="srow"><div class="sk">Requested lead time</div><div class="sv">${esc(leadTime)}</div></div>` : '') +
      (nda ? `<div class="srow"><div class="sk">NDA</div><div class="sv">Requested</div></div>` : '');
    showClientSub('confirm');
    window.scrollTo({top:0});
  }catch(e){
    console.error(e);
    reqWarn('Could not submit: ' + friendlyError(e));
  }finally{
    btn.disabled = false; btn.textContent = 'Submit to estimation team →';
  }
};
