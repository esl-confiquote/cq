  const ndaBtn = $('btn-nda-signed');
  if(ndaBtn) ndaBtn.onclick = () => run(async () => {
    await DB.updateCase(c.caseNo, { ndaStatus: 'Signed' }, [entry('NDA countersigned by ESL and attached to the case.')]);
  });
  $('est-quote-amount').oninput = e => { estDraft(c).amount = e.target.value; };
  $('est-quote-notes').oninput = e => { estDraft(c).notes = e.target.value; };
  [...TERM_FIELDS.map(t => t[1]), 'est-q-tax'].forEach(id => { $(id).addEventListener('input', () => { estDraft(c).terms = readTerms(); }); $(id).addEventListener('change', () => { estDraft(c).terms = readTerms(); }); });
  $('btn-upload-quote-doc').onclick = () => doUpload(c, 'quotation', DOC_ACCEPT, false, { text: 'Quotation document attached by the estimator.' });
  $('btn-issue-quote').onclick = () => run(async () => {
    const amt = Number($('est-quote-amount').value);
    const notes = $('est-quote-notes').value.trim();
    if(!(amt > 0)){ toast('Enter a quote amount greater than zero.'); return; }
    const rev = (c.quoteHistory || []).length + 1;
    const patch = { quoteAmount: amt, quoteNotes: notes, quoteRequested: false, quoteTerms: readTerms() };
    if(idx < STATUS_STAGES.indexOf('Quotation Issued')) patch.status = 'Quotation Issued';
    else if(c.status === 'Under Estimator Review') patch.status = 'Quotation Issued';
    await DB.updateCase(c.caseNo, patch, {
      quoteHistory: [{ id: uid8(), t: Date.now(), amount: amt, note: notes, by: state.profile.name, rev }],
      timeline: [entry(rev === 1 ? `Quotation issued — ${fmtMoney(amt)}. Client notified by SMS and email (simulated).` : `Revised quotation issued — ${fmtMoney(amt)} (revision ${rev}). Client notified (simulated).`, { commercial: true })],
    });
    state.estDraft = null;
    toast('Quotation issued — the client can see it now.');
  });
  const adv = $('btn-advance-status');
  if(adv) adv.onclick = () => run(async () => {
    await DB.updateCase(c.caseNo, { status: nextStage }, [entry(`Status updated to ${nextStage}.`)]);
  });
}

/* ---------------------------------------------------------------
   DESIGNER / PRODUCTION ENGINEER CONSOLE
--------------------------------------------------------------- */
const DRAWING_ACCEPT = '.pdf,.png,.jpg,.jpeg,.dwg,.dxf';
const designerFilterOk = (c, f) => {
  const i = stageIdx(c);
  return f === 'all' || (f === 'active' && (i === 3 || i === 4)) || (f === 'done' && i === 5);
};
document.querySelectorAll('#des-filters button').forEach(b => b.onclick = () => {
  state.designerFilter = b.dataset.f;
  document.querySelectorAll('#des-filters button').forEach(x => x.classList.toggle('active', x === b));
  renderDesignerList();
});
function showDesignerListView(){
  $('des-list-view').style.display = 'block';
  $('des-detail-view').style.display = 'none';
}
function renderDesignerList(){
  const wrap = $('designer-table-wrap');
  if(!state.casesLoaded){ wrap.innerHTML = `<div class="cases-empty">Loading cases&hellip;</div>`; return; }
  const list = cases.filter(c => designerFilterOk(c, state.designerFilter));
  if(!list.length){ wrap.innerHTML = `<div class="cases-empty">No cases in this view yet.</div>`; return; }
  wrap.innerHTML = `<table><thead><tr><th>Case No.</th><th>Panel</th><th>Client</th><th>Status</th><th>ETA</th><th>Pictures</th><th>Drawing</th></tr></thead><tbody>
    ${list.map(c => `<tr class="clickable des-row" data-case="${esc(c.caseNo)}"><td>${esc(c.caseNo)}</td><td>${esc(c.panelName)}</td>
      <td>${esc(c.contact.fullName)}${c.contact.company ? ' — ' + esc(c.contact.company) : ''}</td><td>${statusChip(c.status)}</td>
      <td>${c.eta ? esc(fmtDay(c.eta)) : '—'}</td><td>${filesOf(c.caseNo, 'photo').length}</td><td>${filesOf(c.caseNo, 'drawing').length ? '&#10003;' : '—'}</td></tr>`).join('')}
  </tbody></table>`;
  bindCaseRows('des-row', openDesignerDetail);
}
function openDesignerDetail(no){
  state.designerOpenCase = no;
  $('des-list-view').style.display = 'none';
  $('des-detail-view').style.display = 'block';
  renderDesignerDetail();
  window.scrollTo({ top: 0 });
}

function desDraft(c){
  if(!state.desDraft || state.desDraft.caseNo !== c.caseNo) state.desDraft = { caseNo: c.caseNo, note: '', eta: null, reason: '', caption: '' };
  return state.desDraft;
}
function renderDesignerDetail(){
  const dv = $('des-detail-view');
  const c = cases.find(x => x.caseNo === state.designerOpenCase);
  const toList = () => { renderDesignerList(); showDesignerListView(); };
  if(!c){ dv.innerHTML = `<button class="backlink" id="des-back">&larr; Back to case list</button><div class="cases-empty">Case not found.</div>`; $('des-back').onclick = toList; return; }
  const panel = PANELS[c.panelId], idx = stageIdx(c);
  const sz = checkEnclosureSize(c.panelId, c.values);
  const tab = state.designerTab;
  const photos = filesOf(c.caseNo, 'photo'), draws = filesOf(c.caseNo, 'drawing');
  const notes = (c.progressNotes || []).slice().sort((a, b) => b.t - a.t);
  const hist = (c.etaHistory || []).slice().sort((a, b) => b.t - a.t);
  const dr = desDraft(c);
  const tabs = [['notes', 'Progress notes'], ['eta', 'ETA'], ['photos', 'Status pictures'], ['drawing', 'Preliminary drawing']];

  let work = '';
  if(tab === 'notes'){
    work = `<div class="field"><label class="flabel" for="des-note">Custom note on the progress of the panel</label>
        <textarea id="des-note" placeholder="e.g. Enclosure fabrication complete; busbar assembly started.">${esc(dr.note)}</textarea></div>
      <button class="primary" id="btn-add-note">Add progress note</button>
      <div class="hint-text">Notes are visible to the client under step 5 (In Production) of their case.</div>
      ${notes.length ? `<div style="display:grid; gap:8px;">${notes.map(n => `<div class="note-item"><div class="at">${esc(fmtDT(n.t))} · ${esc(n.by || '')}</div>${esc(n.text)}</div>`).join('')}</div>` : `<div class="stage-empty">No progress notes yet.</div>`}`;
  } else if(tab === 'eta'){
    work = `<div><h4 class="h4">Current ETA</h4><div class="eta-big">${c.eta ? esc(fmtDay(c.eta)) : 'Not set yet'}</div>
        ${c.contact.leadTime ? `<div class="hint-text">The client asked for a lead time of ${esc(c.contact.leadTime)}.</div>` : ''}</div>
      <div class="field"><label class="flabel" for="des-eta">${c.eta ? 'Change the ETA' : 'Set the ETA'}</label><input type="date" id="des-eta" value="${esc(dr.eta !== null ? dr.eta : (c.eta || ''))}"></div>
      <div class="field"><label class="flabel" for="des-eta-reason">Reason${c.eta ? ' for the change (required)' : ' (optional)'}</label><textarea id="des-eta-reason" placeholder="e.g. Awaiting delivery of ACB from supplier.">${esc(dr.reason)}</textarea></div>
      <button class="primary" id="btn-set-eta">${c.eta ? 'Update ETA' : 'Set ETA'}</button>
      <div class="hint-text">The client sees the ETA and every change to it.</div>
      ${hist.length ? `<div><h4 class="h4">ETA history</h4>${hist.map(e => `<div class="fb-item"><div class="at">${esc(fmtDT(e.t))} · ${esc(e.by || '')}</div>${e.from ? `${esc(fmtDay(e.from))} &rarr; <b>${esc(fmtDay(e.to))}</b>` : `Set to <b>${esc(fmtDay(e.to))}</b>`}${e.reason ? ' — ' + esc(e.reason) : ''}</div>`).join('')}</div>` : ''}`;
  } else if(tab === 'photos'){
    work = `<div class="field"><label class="flabel" for="des-photo-caption">Caption (optional — applies to the pictures you upload next)</label><input type="text" id="des-photo-caption" placeholder="e.g. Busbar assembly, 14 Nov" value="${esc(dr.caption)}"></div>
      <button class="primary" id="btn-upload-photos">Upload status pictures</button>
      <div class="hint-text">JPG or PNG, several at once. Pictures are compressed automatically. Clients can view and download them.</div>
      ${photos.length ? galleryHTML(photos, true) : `<div class="stage-empty">No status pictures uploaded yet.</div>`}`;
  } else {
    work = `<button class="primary" id="btn-upload-drawing">Upload preliminary drawing</button>
      <div class="hint-text">File size limits apply: up to ${esc(KB(MAX_FILE_BYTES))} per file (PDF, DWG, DXF, or image — images are compressed automatically).</div>
      ${fileListHTML(draws, 'No preliminary drawing uploaded yet.', true)}`;
  }

  dv.innerHTML = `
    <button class="backlink" id="des-back">&larr; Back to case list</button>
    <div class="intro-card">
      <h2>${esc(c.caseNo)} — ${esc(panel.name)}</h2>
      <p>${esc(c.contact.fullName)}${c.contact.company ? ' — ' + esc(c.contact.company) : ''}${c.contact.location ? ' · ' + esc(c.contact.location) : ''}</p>
      <div class="meta-strip" style="margin-top:12px;">
        <div class="mi"><span class="mk">Status</span>${statusChip(c.status)}</div>
        <div class="mi"><span class="mk">Order type</span>${esc(c.contact.orderType)}</div>
        <div class="mi"><span class="mk">ETA</span>${c.eta ? esc(fmtDay(c.eta)) : '—'}</div>
        ${c.contact.leadTime ? `<div class="mi"><span class="mk">Requested lead time</span>${esc(c.contact.leadTime)}</div>` : ''}
      </div>
      ${stageChipsHTML(c.status)}
      ${c.status === 'Client Acceptance' ? `<div style="margin-top:6px;"><button class="primary small" id="btn-start-production">Start production</button> <span class="hint-text">The client has accepted the price. Starting production moves the case to step 5.</span></div>` : ''}
    </div>
    ${shouldWarnATEX(c.values) ? `<div class="warn-banner">&#9888; ATEX / explosion-proof requirement noted but the enclosure is Polycarbonate/GRP — check with the estimator.</div>` : ''}
    ${sz.status === 'flagged' ? `<div class="warn-banner">&#9888; <span><b>Enclosure size flagged:</b> ${sz.issues.map(i => esc(i.text)).join(' ')}</span></div>` : ''}
    <div class="detail-grid">
      <div>
        <section class="qgroup"><div class="qgroup-head"><h3>Configuration results</h3></div><div class="summary-body">${rowsToHTML(specRows(panel, c.values), panel.name)}</div></section>
        <section class="qgroup"><div class="qgroup-head"><h3>Single-line diagram from the client</h3></div><div class="qgroup-body">${fileListHTML(filesOf(c.caseNo, 'diagram'), 'None attached.', false)}</div></section>
        <section class="qgroup"><div class="qgroup-head"><h3>Activity</h3></div><div class="qgroup-body">${activityHTML(c, { hideCommercial: true })}</div></section>
      </div>
      <div>
        <div class="subtabs" role="tablist">${tabs.map(([k, l]) => `<button role="tab" data-dtab="${k}" aria-selected="${tab === k}">${l}</button>`).join('')}</div>
        <section class="qgroup"><div class="qgroup-body">${work}</div></section>
      </div>
    </div>`;

  hydrateThumbs(dv);
  $('des-back').onclick = toList;
  dv.querySelectorAll('[data-dtab]').forEach(b => b.onclick = () => { state.designerTab = b.dataset.dtab; renderDesignerDetail(); });
  [['des-note', 'note'], ['des-eta', 'eta'], ['des-eta-reason', 'reason'], ['des-photo-caption', 'caption']].forEach(([id, k]) => {
    const el = $(id); if(el) el.oninput = el.onchange = () => { dr[k] = el.value; };
  });
  const start = $('btn-start-production');
  if(start) start.onclick = () => run(async () => {
    await DB.updateCase(c.caseNo, { status: 'In Production' }, [entry(`Production started by ${state.profile.name}.`)]);
    toast('Production started — the client can follow progress on their case.');
  });
  const addNote = $('btn-add-note');
  if(addNote) addNote.onclick = () => run(async () => {
    const text = $('des-note').value.trim();
    if(!text){ toast('Type a note first.'); return; }
    await DB.updateCase(c.caseNo, {}, {
      progressNotes: [{ id: uid8(), t: Date.now(), by: state.profile.name, text }],
      timeline: [entry('Production progress note added.')],
    });
    dr.note = '';
    toast('Progress note added.');
  });
  const setEta = $('btn-set-eta');
  if(setEta) setEta.onclick = () => run(async () => {
    const to = $('des-eta').value, reason = $('des-eta-reason').value.trim();
    if(!to){ toast('Pick a date for the ETA.'); return; }
    if(to === c.eta){ toast('That is already the current ETA.'); return; }
    if(c.eta && !reason){ toast('Add a short reason for changing the ETA.'); return; }
    await DB.updateCase(c.caseNo, { eta: to }, {
      etaHistory: [{ id: uid8(), t: Date.now(), from: c.eta || null, to, reason, by: state.profile.name }],
      timeline: [entry(c.eta ? `ETA changed from ${fmtDay(c.eta)} to ${fmtDay(to)}.` : `ETA set to ${fmtDay(to)}.`)],
    });
    dr.eta = null; dr.reason = '';
    toast('ETA updated — the client can see it.');
  });
  const upPhotos = $('btn-upload-photos');
  if(upPhotos) upPhotos.onclick = () => doUpload(c, 'photo', 'image/*', true, () => ({
    caption: ($('des-photo-caption') && $('des-photo-caption').value.trim()) || '',
    text: 'New status pictures of the panel uploaded.',
  }));
  const upDrawing = $('btn-upload-drawing');
  if(upDrawing) upDrawing.onclick = () => doUpload(c, 'drawing', DRAWING_ACCEPT, false, { text: 'Preliminary drawing uploaded.' });
}

/* ---------------------------------------------------------------
   THEME (light / dark)
--------------------------------------------------------------- */
function applyTheme(t){
  document.documentElement.setAttribute('data-theme', t);
  ['light', 'dark'].forEach(k => { const b = $('theme-' + k); if(b) b.setAttribute('aria-pressed', String(k === t)); });
}
function initTheme(){
  applyTheme(document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark');
  document.querySelectorAll('[data-theme-set]').forEach(b => {
    b.onclick = () => {
      applyTheme(b.dataset.themeSet);
      try{ localStorage.setItem('esl-theme', b.dataset.themeSet); }catch(e){}
    };
  });
}

/* ---------------------------------------------------------------
   INIT
--------------------------------------------------------------- */
/* ---- brand assets: ESL logo & panel cut-outs from the ESL catalogue; PPA logo from the quotation template ---- */
const ASSETS = {
  logo_light: 'data:image/webp;base64,',
  logo_dark: 'data:image/webp;base64,',
  mark: 'data:image/webp;base64,',
  ppa: 'data:image/webp;base64,',
  ats: 'data:image/webp;base64,',
  pdp: 'data:image/webp;base64,',
  iso: 'data:image/webp;base64,',
  psc: 'data:image/webp;base64,',
  hero: 'data:image/webp;base64,',
};
(function injectAssets(){
  const st = document.createElement('style');
  st.textContent = ['ats', 'pdp', 'iso', 'psc', 'hero'].map(k => `.pimg-${k}{background-image:url(${ASSETS[k]})}`).join('\n');
  document.head.appendChild(st);
  document.querySelectorAll('[data-asset]').forEach(el => { el.src = ASSETS[el.dataset.asset]; });
  const ic = document.createElement('link'); ic.rel = 'icon'; ic.href = ASSETS.mark; document.head.appendChild(ic);
})();
const prefersReducedMotion = () => !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
function animateCounts(){
  document.querySelectorAll('[data-count]').forEach(el => {
    const target = Number(el.dataset.count);
    if(prefersReducedMotion()){ el.textContent = target; return; }
    const t0 = performance.now(), dur = 1100;
    const step = now => { const p = Math.min(1, (now - t0) / dur); el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))); if(p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  });
}
(function loginParallax(){
  const bg = $('login-bg-img');
  if(!bg || prefersReducedMotion()) return;
  window.addEventListener('mousemove', e => {
    if(!$('view-login').classList.contains('active')) return;
    bg.style.setProperty('--px', ((e.clientX / innerWidth - .5) * -28) + 'px');
    bg.style.setProperty('--py', ((e.clientY / innerHeight - .5) * -10) + 'px');
  }, { passive: true });
})();

initTheme();
boot();

</script>
