/* ---- "Other / specify" boxes, side dropdowns, enclosure-size feasibility ---- */
const needsDetail = o => /^other\b/i.test(o) || /\(specify\)/i.test(o);
function detailOptionSelected(f, val){
  if(f.type === 'pills') return (val && needsDetail(val)) ? val : null;
  if(f.type === 'pills-multi' && Array.isArray(val)) return val.find(needsDetail) || null;
  return null;
}
function formatOption(o, text){
  const base = String(o).replace(/\s*\(specify\)/i, '');
  const t = (text || '').trim();
  return `${base} (${t || 'not specified'})`;
}
function formProblems(panel, values){
  const out = [];
  panel.fields.concat(UNIVERSAL_FIELDS).forEach(f => {
    const val = values[f.id];
    if(detailOptionSelected(f, val) && !(values[f.id + '__other'] || '').trim()) out.push(`${f.label} — please specify`);
    if(f.side && val === 'Side' && !values[f.id + '__side']) out.push(`${f.label} — choose left or right`);
    if(f.type === 'size' && checkEnclosureSize(panel.id, values).status === 'invalid') out.push('Enclosure size — enter numbers in metres, e.g. 2.1');
  });
  return out;
}
function fieldIncomplete(f, values){
  const val = values[f.id];
  if(detailOptionSelected(f, val) && !(values[f.id + '__other'] || '').trim()) return true;
  if(f.side && val === 'Side' && !values[f.id + '__side']) return true;
  if(f.type === 'size' && checkEnclosureSize(state.configuratorPanelId, values).status === 'invalid') return true;
  return false;
}

// Indicative minimum enclosure sizes (H x W x D, metres) by current rating. A guide for flagging only —
// the estimator confirms the final size. Adjust these tables to match ESL's real enclosure range.
const SIZE_BANDS = [
  [125,  [0.6, 0.5, 0.2]], [250,  [0.8, 0.6, 0.25]], [630,  [1.2, 0.8, 0.4]],
  [1000, [1.8, 0.8, 0.5]], [1600, [2.0, 1.0, 0.6]],  [2500, [2.0, 1.2, 0.8]],
  [Infinity, [2.2, 1.6, 0.8]],
];
const bandFor = A => SIZE_BANDS.find(b => A <= b[0])[1];
const maxDims = (a, b) => a.map((x, i) => Math.max(x, b[i]));
const numFrom = s => { const m = String(s == null ? '' : s).replace(',', '.').match(/\d+(?:\.\d+)?/); return m ? parseFloat(m[0]) : null; };
const ampsFrom = s => { const m = String(s || '').match(/(\d+(?:\.\d+)?)\s*A(?![A-Za-z])/i); return m ? parseFloat(m[1]) : null; };
const fm = n => String(Math.round(n * 100) / 100);
const SIZE_LABEL = { small:'Too small', big:'Too large', invalid:'Invalid', conflict:'Check material' };

function minimumSize(panelId, v){
  if(panelId === 'ats'){
    const A = Math.max(0, ...['src1_rating', 'src2_rating', 'busbar_rating'].map(k => numFrom(v[k]) || 0));
    return A ? { dims: bandFor(A), basis: `a ${A} A transfer switch panel` } : { dims: [0.8, 0.6, 0.25], basis: 'a transfer switch panel' };
  }
  if(panelId === 'pdp'){
    const A = Math.max(ampsFrom(v.incoming_rating) || 0, numFrom(v.busbar_rating) || 0);
    const w = v.outgoing_ways || '';
    let ways = [0.8, 0.6, 0.25], waysTxt = '';
    if(w === '5\u20138'){ ways = [1.2, 0.8, 0.3]; waysTxt = ' with 5\u20138 outgoing ways'; }
    else if(w.startsWith('9+')){
      const n = numFrom(v['outgoing_ways__other']);
      ways = n && n > 20 ? [2.2, 1.6, 0.6] : n && n > 12 ? [2.0, 1.2, 0.5] : [1.8, 0.8, 0.4];
      waysTxt = ` with ${n || '9+'} outgoing ways`;
    } else if(w){ waysTxt = ' with up to 4 outgoing ways'; }
    return { dims: A ? maxDims(bandFor(A), ways) : ways, basis: `a ${A ? A + ' A ' : ''}distribution board${waysTxt}` };
  }
  if(panelId === 'iso'){
    const bc = v.breaking_capacity || '', kA = numFrom(bc) || 0;
    return { dims: kA >= 100 ? [0.8, 0.6, 0.3] : kA >= 36 ? [0.6, 0.4, 0.25] : [0.4, 0.3, 0.2], basis: `an isolator panel${bc ? ' rated ' + bc : ''}` };
  }
  if(panelId === 'psc'){
    const kA = numFrom(v.breaking_capacity) || 0;
    return { dims: kA >= 100 ? [1.0, 0.8, 0.4] : kA >= 36 ? [0.8, 0.6, 0.3] : [0.6, 0.4, 0.25], basis: 'a phase sequence correction panel' };
  }
  return { dims: [0.4, 0.3, 0.15], basis: 'this panel' };
}
function maximumSize(v){
  const limits = [{ d: [2.4, 3.0, 1.2], why: 'practical fabrication / transport limit for a single assembly' }];
  if(v.material === 'Polycarbonate') limits.push({ d: [1.2, 0.8, 0.4], why: 'usual maximum for polycarbonate enclosures' });
  if(v.material === 'GRP') limits.push({ d: [1.8, 1.2, 0.6], why: 'usual maximum for GRP enclosures' });
  if(v.mounting === 'Wall-mounted') limits.push({ d: [1.2, 0.8, 0.4], why: 'maximum for a wall-mounted unit' });
  const dims = [], why = [];
  for(let i = 0; i < 3; i++){
    let best = limits[0];
    limits.forEach(l => { if(l.d[i] < best.d[i]) best = l; });
    dims.push(best.d[i]); why.push(best.why);
  }
  return { dims, why };
}
function checkEnclosureSize(panelId, v){
  const names = ['Height', 'Width', 'Depth'], keys = ['size_h', 'size_w', 'size_d'];
  const raw = keys.map(k => String(v[k] == null ? '' : v[k]).trim());
  if(raw.every(x => !x)) return { status: 'empty', issues: [] };
  const vals = raw.map(x => x ? numFrom(x) : null);
  const issues = [];
  raw.forEach((x, i) => {
    if(x && (vals[i] === null || !/^\d+([.,]\d+)?\s*m?$/i.test(x) || vals[i] <= 0 || vals[i] > 10))
      issues.push({ type: 'invalid', text: `${names[i]} must be a number in metres (e.g. 2.1).` });
  });
  if(issues.length) return { status: 'invalid', issues };
  const mn = minimumSize(panelId, v), mx = maximumSize(v);
  vals.forEach((x, i) => {
    if(x == null) return;
    if(x < mn.dims[i] - 0.005) issues.push({ type: 'small', text: `${names[i]} ${fm(x)} m is below the indicative minimum of ${fm(mn.dims[i])} m for ${mn.basis}.` });
    if(x > mx.dims[i] + 0.005) issues.push({ type: 'big', text: `${names[i]} ${fm(x)} m is above the ${fm(mx.dims[i])} m ${mx.why[i]}.` });
  });
  const conflict = [0, 1, 2].find(i => mn.dims[i] > mx.dims[i] + 0.005);
  if(conflict !== undefined) issues.push({ type: 'conflict', text: `${mn.basis[0].toUpperCase() + mn.basis.slice(1)} needs at least ${fm(mn.dims[conflict])} m ${names[conflict].toLowerCase()}, which is above the ${fm(mx.dims[conflict])} m ${mx.why[conflict]} — consider mild or stainless steel, or a multi-section build.` });
  return { status: issues.length ? 'flagged' : 'ok', issues, min: mn.dims, max: mx.dims };
}
function updateSizeCheck(){
  const el = $('size-check');
