function handleAuth(profile){
  if(!profile){ showLogin(); return; }
  if(profile.error){
    authError = { page: state.loginPage, msg: "Your account exists but has no role assigned yet. Ask TAGG to finish setting it up, then sign in again." };
    DB.signOut();
    return;
  }
  const intent = state.loginIntent;
  state.loginIntent = null;
  if(intent && intent.kind === 'client' && profile.role !== 'client'){
    authError = { page: 'client', msg: 'This is a TAGG staff account. Use the "TAGG Staff" link below to sign in.' };
    DB.signOut(); return;
  }
  if(intent && intent.kind === 'staff' && profile.role !== intent.role){
    authError = { page: 'staff', msg: `This account isn't registered as ${ROLE_LABEL[intent.role]}. Choose the portfolio TAGG registered you for.` };
    DB.signOut(); return;
  }
  enterApp(profile);
}

function teardown(){
  unsubs.forEach(u => { try{ u(); }catch(e){} });
  unsubs = [];
  cases = []; caseFiles = []; callLog = [];
  dataCache.clear();
  state.casesLoaded = false;
}

function showLogin(){
  teardown();
  $('toast').classList.remove('show');
  state.role = null; state.profile = null; state.currentEstimatorId = null;
  renderSessionBox();
  showTopView('login');
  animateCounts();
  if(authError){ state.loginPage = authError.page; }
  const page = state.loginPage;
  $('login-fatal').style.display = 'none';
  $('login-estimator-pick').style.display = 'none';
  $('login-demo').style.display = (!LIVE_ACTIVE && page === 'client') ? 'block' : 'none';
  $('login-live').style.display = (LIVE_ACTIVE && page === 'client') ? 'grid' : 'none';
  $('login-staff').style.display = page === 'staff' ? 'grid' : 'none';
  $('auth-error').innerHTML = ''; $('staff-error').innerHTML = '';
  if(authError){
    if(authError.page === 'staff') showStaffError(authError.msg); else showAuthError(authError.msg);
    authError = null;
  }
  $('auth-password').value = ''; $('staff-password').value = '';
}

function enterApp(profile){
  teardown();
  $('toast').classList.remove('show');
  state.profile = profile;
  state.role = profile.role;
  state.currentEstimatorId = profile.estimatorId || null;
  Object.assign(state, {
    configuratorPanelId: null, configuratorValues: {}, editCaseNo: null, showErrors: false,
    mycOpenCase: null, mycStage: null, mycStageCase: null, fbDraft: { text: '', discount: null },
    salesFilter: 'all', salesOpenCase: null, salesStage: null, salesStageCase: null,
    estFilter: 'all', estOpenCaseNo: null, estDraft: null, desDraft: null, designerFilter: 'all', designerOpenCase: null, designerTab: 'notes',
    adminSelectedCase: null, simCall: null,
  });
  renderSessionBox();
  showTopView(profile.role);

  const subs = opts => {
    unsubs.push(DB.subscribeCases(opts, onCases));
    unsubs.push(DB.subscribeFiles(opts, onFiles));
  };
  if(profile.role === 'client'){
    subs({ ownerUid: profile.uid });
    configureClientTabs();
    renderRail(); renderForm(); renderSummary(); updateMyCasesBadge(); showClientSub('configure');
  } else if(profile.role === 'sales'){
    subs({ all: true });
    configureClientTabs();
    renderRail(); renderForm(); renderSummary();
    showClientSub('salesreqs'); renderSalesList();
  } else if(profile.role === 'estimator'){
    subs({ all: true });
    renderEstimatorList(); showEstimatorListView();
  } else if(profile.role === 'designer'){
    subs({ all: true });
    renderDesignerList(); showDesignerListView();
  } else if(profile.role === 'admin'){
    unsubs.push(DB.subscribeCases({ all: true }, onCases));
    unsubs.push(DB.subscribeCallLog(l => { callLog = l; renderAdminCallLog(); }));
    renderAdmin();
  }
}

function onCases(list){
  cases = list.slice().sort((a, b) => (b.createdAtMs || 0) - (a.createdAtMs || 0));
