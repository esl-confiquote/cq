    ${c.quoteNotes ? `<div style="white-space:pre-wrap; overflow-wrap:anywhere;">${esc(c.quoteNotes)}</div>` : ''}
    <div class="btn-row"><button class="ghost small" data-print-quote="${esc(c.caseNo)}">Print / save quotation (PDF)</button>
    ${mode === 'client' && c.status === 'Quotation Issued' ? `<button class="primary small" data-gostage="3">Respond to this price &rarr;</button>` : ''}</div></div>`;
