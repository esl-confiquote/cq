  const r = checkEnclosureSize(state.configuratorPanelId, state.configuratorValues);
  const minStr = minimumSize(state.configuratorPanelId, state.configuratorValues).dims.map(fm).join(' × ');
  if(r.status === 'empty'){ el.innerHTML = `<div class="fhint">Indicative minimum for this configuration: ${minStr} m (H × W × D). ESL confirms the final size.</div>`; return; }
  if(r.status === 'ok'){ el.innerHTML = `<div class="size-flag ok">&#10003; Within the indicative range for this configuration (minimum ${minStr} m).</div>`; return; }
  const cls = r.status === 'invalid' ? 'warn' : 'bad';
  el.innerHTML = `<div class="size-flag ${cls}">` + r.issues.map(i => `<div><b>${SIZE_LABEL[i.type]}</b>${esc(i.text)}</div>`).join('') +
