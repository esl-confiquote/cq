    `https://esm.sh/@supabase/supabase-js@${SUPABASE_SDK_VERSION}`,
    `https://cdn.jsdelivr.net/npm/@supabase/supabase-js@${SUPABASE_SDK_VERSION}/+esm`,
  ];
  for(const u of urls){
    try{ mod = await import(u); break; }catch(e){ lastErr = e; console.warn('Supabase library failed to load from', u, e); }
  }
  if(!mod) throw lastErr || new Error('network');
  const sb = mod.createClient(String(SUPABASE_URL).trim().replace(/\/+$/,'').replace(/\/(rest|auth|realtime|storage)\/v1.*$/,''), String(SUPABASE_ANON_KEY).trim(), {
    auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true },
  });

  // unwrap { data, error } and keep the error code so friendlyError() can explain it
  const unwrap = res => {
    if(res && res.error){
      const e = new Error(res.error.message || 'Request failed');
      e.code = res.error.code || res.error.status || '';
      throw e;
    }
    return res ? res.data : null;
  };

  async function loadProfile(uid){
    // right after sign-up the profile row is written by a database trigger — retry briefly
    for(let i = 0; i < 4; i++){
      try{
        const data = unwrap(await sb.from('profiles').select('name,email,role,company,location,estimator_id').eq('id', uid).maybeSingle());
        if(data) return data;
      }catch(e){ console.error('profile read failed', e); }
      await new Promise(r => setTimeout(r, 600));
    }
    return null;
  }

  // fetch a list, then refetch whenever the table changes (Realtime) — plus a slow safety poll
  function watch(table, fetcher, cb, what){
    let stopped = false, timer = null, loaded = false;
    const run = async () => {
      try{ const rows = await fetcher(); loaded = true; if(!stopped) cb(rows); }
      catch(err){
        console.error(err);
        if(!stopped && !loaded){ toast(`Could not load ${what}: ` + friendlyError(err)); loaded = true; cb([]); }
      }
    };
    run();
    let ch = null;
    try{
      ch = sb.channel(`${table}-${Math.random().toString(36).slice(2, 8)}`)
        .on('postgres_changes', { event: '*', schema: 'public', table }, () => { clearTimeout(timer); timer = setTimeout(run, 250); })
        .subscribe();
    }catch(e){ console.warn('Realtime unavailable — falling back to polling', e); }
    const poll = setInterval(run, 30000);
    return () => { stopped = true; clearInterval(poll); clearTimeout(timer); if(ch){ try{ sb.removeChannel(ch); }catch(e){} } };
  }

  return {
    mode: 'live',
    onAuth(cb){
      let currentId = undefined;   // undefined = nothing reported yet, null = signed out
      sb.auth.onAuthStateChange((event, session) => {
        // never await Supabase calls directly inside this callback (can deadlock) — hop out first
        setTimeout(async () => {
          if(event === 'PASSWORD_RECOVERY'){
            const pw = window.prompt('Choose a new password (at least 6 characters):');
            if(pw){
              const { error } = await sb.auth.updateUser({ password: pw });
              toast(error ? 'Could not change the password: ' + friendlyError(error) : 'Password changed.');
            }
          }
          const user = session && session.user;
          if(!user){ if(currentId !== null){ currentId = null; cb(null); } return; }
          if(currentId === user.id) return;           // token refreshes etc. — nothing to do
          currentId = user.id;
          const prof = await loadProfile(user.id);
          if(currentId !== user.id) return;           // signed out while loading
          if(!prof || !ROLE_LABEL[prof.role]) return cb({ uid: user.id, error: 'noprofile' });
          cb({ uid: user.id, email: user.email, name: prof.name || user.email, role: prof.role,
               estimatorId: prof.estimator_id || null, company: prof.company || '', location: prof.location || '' });
        }, 0);
      });
    },
    async signIn(email, pw){ unwrap(await sb.auth.signInWithPassword({ email, password: pw })); },
    async signUp(name, email, pw, company, location){
      const data = unwrap(await sb.auth.signUp({ email, password: pw, options: { data: { name, company, location } } }));
      if(data && data.user && data.user.identities && data.user.identities.length === 0){
        const e = new Error('exists'); e.code = 'user_already_exists'; throw e;
      }
      if(data && !data.session){
        const e = new Error('Account created — check your email for a confirmation link, then sign in.');
        e.code = 'confirm-email'; throw e;
      }
    },
    async resetPassword(email){
      unwrap(await sb.auth.resetPasswordForEmail(email, { redirectTo: location.origin + location.pathname }));
    },
    async signOut(){ await sb.auth.signOut(); },

    subscribeCases(opts, cb){
      return watch('cases', async () => {
        let q = sb.from('cases').select('data').order('created_at', { ascending: false });
        if(!opts.all) q = q.eq('owner_uid', opts.ownerUid);
        return unwrap(await q).map(r => r.data);
      }, cb, 'cases');
    },
    subscribeFiles(opts, cb){
      return watch('case_files', async () => {
        let q = sb.from('case_files').select('meta').order('created_at', { ascending: true });
        if(!opts.all) q = q.eq('owner_uid', opts.ownerUid);
        return unwrap(await q).map(r => r.meta);
      }, cb, 'files');
    },
    subscribeCallLog(cb){
      return watch('call_log', async () =>
        unwrap(await sb.from('call_log').select('data').order('t', { ascending: false }).limit(50)).map(r => r.data),
        cb, 'call log');
    },
    async createCase(record){
      return unwrap(await sb.rpc('create_case', { p_record: record }));   // returns the new case number
    },
    async updateCase(caseNo, patch, appends){
      if(Array.isArray(appends)) appends = { timeline: appends };
      const clean = {};
      Object.entries(appends || {}).forEach(([k, items]) => { if(items && items.length) clean[k] = items; });
      unwrap(await sb.rpc('update_case', {
        p_case_no: caseNo, p_patch: Object.assign({}, patch || {}, { updatedAt: Date.now() }), p_appends: clean }));
    },
    async addCallNote(caseNo, note, tl){
      unwrap(await sb.rpc('add_call_note', { p_case_no: caseNo, p_note: note, p_tl: tl, p_updated: Date.now() }));
    },
    async addFile(meta, dataUrl){
      unwrap(await sb.rpc('add_file', { p_meta: meta, p_data: dataUrl }));   // metadata + data in one transaction
    },
    async getFileData(id){
      const row = unwrap(await sb.from('file_data').select('data_url').eq('id', id).maybeSingle());
      return row ? row.data_url : null;
    },
    async deleteFile(id){
      const rows = unwrap(await sb.from('case_files').delete().eq('id', id).select('id'));
      if(!rows || !rows.length){ const e = new Error('denied'); e.code = '42501'; throw e; }
    },
  };
}

