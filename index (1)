function clientStagePanelHTML(c, i, mode){
  const idx = stageIdx(c), est = estOf(c.assignedEstimatorId);
  let body = '';
  if(i === 0){
    body = srowsHTML([
      ['Case number', esc(c.caseNo)],
      ['Submitted', esc(fmtDT(c.createdAtMs)) + (c.contact.fullName ? ' · ' + esc(c.contact.fullName) : '')],
      ['Panel', esc(c.panelName)],
      ['Order type', esc(c.contact.orderType)],
      ['Urgency', esc(c.contact.urgency)],
      ...(c.contact.leadTime ? [['Requested lead time', esc(c.contact.leadTime)]] : []),
      ['NDA', esc(c.ndaStatus)],
    ]) + `<p class="hint-text">Your configuration and contact details were received and a case number was issued.${c.onBehalfOf ? ' This request was entered for the client by ' + esc(c.createdBy) + '.' : ''}</p>`;
  } else if(i === 1){
    const rows = [['Assigned estimator', est ? esc(est.name + ' — ' + est.specialty) : 'Waiting to be assigned']];
    if(isProject(c)) rows.push(['Site survey', 'Required before pricing is finalised']);
    if(c.quoteRequested) rows.push(['Quotation requested', esc(fmtDT(c.quoteRequestedAt || 0)) + (c.quoteRequestedBy ? ' · by ' + esc(c.quoteRequestedBy) : '')]);
    body = srowsHTML(rows) + `<p class="hint-text">${idx < 1 ? 'An estimator will pick up the case shortly (target: within 48 hours).' : idx === 1 ? 'The estimator is reviewing the specification and preparing a quotation.' : 'Estimator review is complete.'}</p>`;
  } else if(i === 2) body = quoteStageHTML(c, idx, mode);
  else if(i === 3) body = acceptanceStageHTML(c, idx, mode);
  else if(i === 4) body = productionStageHTML(c, idx);
  else body = deliveredStageHTML(c, idx);
  return `<section class="stage-panel"><h3>Step ${i + 1} — ${esc(STATUS_STAGES[i])}</h3>${body}</section>`;
