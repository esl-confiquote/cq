        </div></section>
      </div>
    </div>`;

  $('sales-back').onclick = () => { showClientSub('salesreqs'); renderSalesList(); };
  root.querySelectorAll('.stage[data-stage]').forEach(b => b.onclick = () => { state.salesStage = Number(b.dataset.stage); renderSalesDetail(); });
  bindStagePanel(root, c, 'view', n => { if(n != null) state.salesStage = n; renderSalesDetail(); });
  $('btn-sales-edit').onclick = () => startSalesEdit(c.caseNo);
  $('btn-sales-quote').onclick = () => salesRequestQuote(c);
  $('btn-sales-jcf').onclick = () => doUpload(c, 'jcf', DOC_ACCEPT, false, { text: `Job completion form uploaded by ${state.profile.name} (sales).` });
  $('btn-sales-waybill').onclick = () => doUpload(c, 'waybill', DOC_ACCEPT, false, { text: `Waybill uploaded by ${state.profile.name} (sales).` });
  const close = $('btn-sales-close');
