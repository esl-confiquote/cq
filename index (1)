    await DB.updateCase(c.caseNo, { status: 'Delivered & Closed' }, { timeline: [entry(`Order marked delivered & closed by ${state.profile.name} (sales).`)] });
    toast('Case closed. The client can now download the waybill' + (proj ? ' and JCF.' : '.'));
  });
}

function salesRequestQuote(c){
  return run(async () => {
    if(stageIdx(c) >= 3){ toast('The client has already accepted the price.'); return; }
    const patch = { quoteRequested: true, quoteRequestedAt: Date.now(), quoteRequestedBy: state.profile.name };
    if(c.status === 'Quotation Issued') patch.status = 'Under Estimator Review';
    await DB.updateCase(c.caseNo, patch, { timeline: [entry(`Quotation requested from the estimator by ${state.profile.name} (sales) on behalf of the client.`)] });
    toast('Quote request sent to the estimator.');
  });
}

/* ---- edit an existing client's configuration (re-uses the configurator) ---- */
function resetConfigurator(){
  state.configuratorPanelId = null; state.configuratorValues = {}; state.showErrors = false;
  renderRail(); renderForm(); renderSummary();
}
function startSalesEdit(no){
  const c = cases.find(x => x.caseNo === no);
  if(!c) return;
  if(stageIdx(c) >= 4){ toast('The configuration is locked once production starts.'); return; }
  state.editCaseNo = no;
  state.configuratorPanelId = c.panelId;
  state.configuratorValues = JSON.parse(JSON.stringify(c.values || {}));
  state.showErrors = false;
  renderRail(); renderForm(); renderSummary();
  showClientSub('configure');
  window.scrollTo({ top: 0 });
}
function cancelSalesEdit(){
  state.editCaseNo = null;
  resetConfigurator();
  showClientSub('salesdetail'); renderSalesDetail();
}
function saveSalesEdit(){
  return run(async () => {
    const c = cases.find(x => x.caseNo === state.editCaseNo);
    if(!c) return;
    const panel = PANELS[c.panelId];
    if(formProblems(panel, state.configuratorValues).length){
      state.showErrors = true; renderForm();
      const b = $('form-problems'); if(b) b.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    const values = JSON.parse(JSON.stringify(state.configuratorValues));
    await DB.updateCase(c.caseNo, { values, configUpdatedAt: Date.now() },
      { timeline: [entry(`Configuration updated by ${state.profile.name} (sales) on behalf of the client.`)] });
    state.editCaseNo = null;
    resetConfigurator();
    showClientSub('salesdetail'); renderSalesDetail();
    toast('Configuration saved. The client sees the update on their case.');
  });
}

