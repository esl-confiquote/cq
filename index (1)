function bindStagePanel(root, c, mode, goStage){
  root.querySelectorAll('[data-print-quote]').forEach(b => b.onclick = () => printQuotation(c));
  root.querySelectorAll('[data-gostage]').forEach(b => b.onclick = () => goStage(Number(b.dataset.gostage)));
  hydrateThumbs(root);
  if(mode !== 'client') return;
  const ta = root.querySelector('#fb-text');
  if(ta) ta.addEventListener('input', () => { state.fbDraft.text = ta.value; });
  root.querySelectorAll('[data-disc]').forEach(cb => cb.addEventListener('change', () => {
    state.fbDraft.discount = cb.checked ? Number(cb.dataset.disc) : null;
    goStage(null);   // re-render in place
  }));
  const acc = root.querySelector('#btn-accept-price');
  if(acc) acc.onclick = () => clientAccept(c);
  const snd = root.querySelector('#btn-send-feedback');
  if(snd) snd.onclick = () => clientSendFeedback(c);
}
function clientAccept(c){
  return run(async () => {
    if(c.status !== 'Quotation Issued') return;
    const text = state.fbDraft.text.trim(), now = Date.now();
    const appends = { timeline: [entry(`Client confirmed acceptance of the quoted price (${fmtMoney(c.quoteAmount)}).`, { commercial: true })] };
    if(text) appends.priceFeedback = [{ id: uid8(), t: now, by: state.profile.name, text, discount: null, amount: c.quoteAmount, kind: 'acceptance' }];
    await DB.updateCase(c.caseNo, { status: 'Client Acceptance', acceptedAt: now, acceptedAmount: c.quoteAmount }, appends);
    state.fbDraft = { text: '', discount: null };
    state.mycStage = null;
    toast('Price accepted — thank you.');
  });
}
function clientSendFeedback(c){
  return run(async () => {
    const text = state.fbDraft.text.trim(), d = state.fbDraft.discount;
    if(!text && !d){ toast('Add a comment or choose a discount to request.'); return; }
    const rec = { id: uid8(), t: Date.now(), by: state.profile.name, text, discount: d || null, amount: c.quoteAmount, kind: 'feedback' };
    await DB.updateCase(c.caseNo, {}, { priceFeedback: [rec], timeline: [entry(`Client sent price feedback${d ? ' and requested a ' + d + '% discount' : ''}.`, { commercial: true })] });
    state.fbDraft = { text: '', discount: null };
    toast('Sent to your estimator.');
  });
}

