  const values = state.configuratorValues;
  const allFields = panel.fields.concat(UNIVERSAL_FIELDS);
  const editCase = state.editCaseNo ? cases.find(x => x.caseNo === state.editCaseNo) : null;
  const editBanner = editCase ? `<div class="info-banner">&#9432; <span>Editing <b>${esc(editCase.caseNo)}</b> on behalf of ${esc(editCase.contact.fullName)}. Saved changes appear on the client's case straight away; then use <b>Request quotation</b> on the case so the estimator re-prices it.</span></div>` : '';
  const warn = shouldWarnATEX(values) ? `<div class="warn-banner" id="atex-warn">&#9888; Enclosure material is Polycarbonate or GRP, but the notes mention an ATEX / explosion-proof requirement. Metallic enclosures are typically required for ATEX-rated environments — this will be flagged to the estimator for confirmation.</div>` : '';
  const problems = state.showErrors ? formProblems(panel, values) : [];
  const probBanner = problems.length ? `<div class="warn-banner" id="form-problems">&#9888; <span>Please complete: ${problems.map(esc).join('; ')}.</span></div>` : '';
  col.innerHTML = `
    ${panelHeroHTML(panel)}
    ${editBanner}${probBanner}${warn}
    <section class="qgroup"><div class="qgroup-head"><h3>Panel specification</h3></div><div class="qgroup-body">${panel.fields.map(f => fieldHTML(f, values)).join('')}</div></section>
    <section class="qgroup"><div class="qgroup-head"><h3>Enclosure &amp; installation (applies to every panel)</h3></div><div class="qgroup-body">${UNIVERSAL_FIELDS.map(f => fieldHTML(f, values)).join('')}</div></section>
    ${editCase ? `<div class="submit-bar"><div class="note">Save to update the client's case, or cancel to leave it unchanged.</div><div class="btn-row"><button class="ghost" id="btn-cancel-edit">Cancel</button><button class="primary" id="btn-save-edit">Save configuration changes</button></div></div>` : `<div class="submit-bar">
      <div class="note">${state.role === 'sales' ? "Continue to enter the client's contact and project details." : 'Continue to bundle this specification with your contact details and submit it to the estimation team.'}</div>
      <button class="primary" id="btn-continue-request">Continue to request quotation &rarr;</button>
    </div>`}`;
  const heroDet = col.querySelector('.ph-more');
  if(heroDet) heroDet.addEventListener('toggle', () => { state.heroOpen = heroDet.open; });
  col.querySelectorAll('.pill').forEach(btn => {
    btn.addEventListener('click', () => {
      const fid = btn.dataset.field, mode = btn.dataset.mode, v = btn.dataset.val;
      if(mode === 'single'){
        if(values[fid] === v) delete values[fid]; else values[fid] = v;
      } else {
        const arr = Array.isArray(values[fid]) ? values[fid].slice() : [];
        const idx = arr.indexOf(v);
        if(idx > -1) arr.splice(idx, 1); else arr.push(v);
        values[fid] = arr;
      }
      const f = allFields.find(x => x.id === fid);
      if(!detailOptionSelected(f, values[fid])) delete values[fid + '__other'];
      if(f.side && values[fid] !== 'Side') delete values[fid + '__side'];
      renderForm(); renderSummary();
    });
  });
  col.querySelectorAll('input[type=text], textarea').forEach(inp => {
    inp.addEventListener('input', () => {
      values[inp.dataset.field] = inp.value;
      renderSummary();
      updateSizeCheck();
      const warnEl = col.querySelector('#atex-warn');
      const should = shouldWarnATEX(values);
      if((should && !warnEl) || (!should && warnEl)){
        const pos = inp.selectionStart, fid = inp.dataset.field;
        renderForm();
        const again = col.querySelector(`[data-field="${fid}"]`);
        if(again){ again.focus(); try{ again.setSelectionRange(pos, pos); }catch(e){} }
      }
    });
  });
  col.querySelectorAll('select[data-field]').forEach(sel => {
    sel.addEventListener('change', () => { values[sel.dataset.field] = sel.value; renderSummary(); });
  });
  if(editCase){ $('btn-save-edit').onclick = saveSalesEdit; $('btn-cancel-edit').onclick = cancelSalesEdit; }
  else $('btn-continue-request').onclick = goToRequestScreen;
  updateSizeCheck();
}
function renderSummary(){
  const body = $('summary-body');
  const th = $('sum-thumb'), pg = $('sum-progress');
  if(!state.configuratorPanelId){
    body.innerHTML = `<div class="summary-empty">Select a panel family to begin.</div>`;
    if(th) th.className = 'sum-thumb'; if(pg) pg.innerHTML = '';
    return;
  }
  const panel = PANELS[state.configuratorPanelId];
  const a = answeredCount(panel, state.configuratorValues), pct = a.total ? Math.round(a.n / a.total * 100) : 0;
  if(th) th.className = 'sum-thumb pimg-' + panel.id;
  if(pg) pg.innerHTML = `<div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${pct}" aria-label="Specification completeness"><i style="width:${pct}%"></i></div><div class="progress-cap"><span>Specified</span><b>${a.n} of ${a.total} questions</b></div>`;
